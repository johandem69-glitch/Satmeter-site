# ---------------------------------------------------------------------------
# Satmeter.io — server configuratie
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# www -> non-www redirect (voorkomt dubbele content op satmeter.io)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.satmeter\.io$ [NC]
  RewriteRule ^(.*)$ https://satmeter.io/$1 [L,R=301]

  # -------------------------------------------------------------------------
  # index.html -> map-URL (permanent)
  # Google vond /index.html en /es/index.html als aparte URL naast / en /es/.
  # Die zijn identiek, dus we sturen ze permanent door naar de canonieke URL.
  # THE_REQUEST kijkt naar wat de bezoeker echt opvroeg, zodat Apache's eigen
  # interne "/ -> index.html" stap geen oneindige lus veroorzaakt.
  # Let op: articles/index.html en tools/index.html blijven bewust ongemoeid,
  # dat zijn echte, geindexeerde pagina's.
  # -------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://satmeter.io/ [L,R=301]

  RewriteCond %{THE_REQUEST} \s/es/index\.html[\s?] [NC]
  RewriteRule ^es/index\.html$ https://satmeter.io/es/ [L,R=301]
</IfModule>

# De notities in /docs/ horen bij de repository, niet bij de website.
# Blokkeer ze zodat bezoekers ze niet kunnen opvragen.
<FilesMatch "\.(md|markdown)$">
  Require all denied
</FilesMatch>

# Ook de map zelf niet doorzoekbaar maken.
Options -Indexes

# ---------------------------------------------------------------------------
# Caching: assets mogen lang blijven staan, HTML moet vers blijven
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# Compressie
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Beveiligingsheaders
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
