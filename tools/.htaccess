# ---------------------------------------------------------------------------
# tools.satmeter.io — server configuratie (zelfde patroon als satmeter.io)
# ---------------------------------------------------------------------------

<FilesMatch "\.(md|markdown)$">
  Require all denied
</FilesMatch>

Options -Indexes

# ---------------------------------------------------------------------------
# Caching: assets mogen lang blijven staan, HTML moet vers blijven
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# Compressie
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Beveiligingsheaders
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
